{
	"name": "n8n-nodes-formswrite",
	"version": "0.1.0",
	"description": "n8n community node for Formswrite — convert documents into quizzes and forms in 25+ formats including Google Forms, Moodle, Kahoot, Quizizz, Canvas, and more.",
	"license": "MIT",
	"homepage": "https://formswrite.com",
	"keywords": [
		"n8n-community-node-package",
		"formswrite",
		"quiz",
		"form",
		"google-forms",
		"moodle",
		"kahoot",
		"quizizz",
		"canvas",
		"qti",
		"lms",
		"education"
	],
	"author": {
		"name": "Formswrite",
		"email": "support@formswrite.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/formswrite/n8n-nodes-formswrite.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/FormswriteApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Formswrite/Formswrite.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.0.1",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
